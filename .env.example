# Copia este archivo como .env y completa los valores. .env NO se sube a git.
POSTGRES_DB=calendai
POSTGRES_USER=calendai_user
POSTGRES_PASSWORD=cambia-esta-contraseña

# Clave para firmar los tokens de sesión (mínimo 32 caracteres aleatorios).
# Genera una con:  openssl rand -base64 48
JWT_KEY=

# Opcional: Google Places (búsqueda de lugares al crear eventos)
GOOGLE_PLACES_API_KEY=

# Opcional: asistente de IA. Clave de https://aistudio.google.com/apikey
# Sin clave la aplicación funciona igual; solo se desactivan las funciones de IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
